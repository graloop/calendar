# Copy this file to .env. `npm start` makes the copy for you the first time.
# .env is never committed.

# Where the database lives. Relative to backend/. In the container it's /data.
# DATA_DIR=./data

# The timezone the dates and times are in. One user, one timezone.
TZ=America/Toronto

# Swagger API docs at /docs. Off unless you need them.
ENABLE_API_DOCS=false

# Claude's connector (see MCP_PLAN.md). Off unless true. When on, MCP_HOST and
# MCP_PASSWORD_HASH are both needed, or it stays off and says why in the logs.
# MCP_ENABLED=false
# MCP_HOST=agenda-mcp.graloop.com
# Make it with: python -m app.mcp.hashpw (from backend/). The hash, never the password.
# MCP_PASSWORD_HASH=
# MCP_TOKEN_DAYS=30
