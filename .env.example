# Copy this file to .env. `npm start` makes the copy for you the first time.
# .env is never committed.

# Where the database lives. Relative to backend/. In the container it's /data.
# DATA_DIR=./data

# The timezone the dates and times are in. One user, one timezone.
TZ=America/Toronto

# Swagger API docs at /docs. Off unless you need them.
ENABLE_API_DOCS=false
